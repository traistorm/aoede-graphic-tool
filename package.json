{
  "name": "slp-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Client-side web app to read, export and author Age of Empires 1 / AoE1:DE .slp sprite files",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
